{"code":"#include <LiquidCrystal.h>\n\n// =====================================================\n// ORIGINAL 20x4 LCD\n// RS = 13\n// E  = 12\n// D4 = 11\n// D5 = 10\n// D6 = 9\n// D7 = 8\n// =====================================================\n\nLiquidCrystal lcd(13, 12, 11, 10, 9, 8);\n\n\n// =====================================================\n// NEW 16x2 LCD\n// RS = A4\n// E  = A5\n// D4 = 11\n// D5 = 10\n// D6 = 9\n// D7 = 8\n// =====================================================\n\nLiquidCrystal lcd2(A4, A5, 11, 10, 9, 8);\n\n\n// =====================================================\n// PIN DEFINITIONS\n// =====================================================\n\nconst int Fan_Pin = 6;\nconst int Pump_Pin = 7;\n\n\n// =====================================================\n// SETUP\n// =====================================================\n\nvoid setup()\n{\n    // -------------------------------------------------\n        // Original 20x4 LCD\n            // -------------------------------------------------\n\n                lcd.begin(20, 4);\n\n                    lcd.setCursor(0, 0);\n                        lcd.print(\" IoT SMART FARMING \");\n\n\n                            // -------------------------------------------------\n                                // New 16x2 LCD\n                                    // -------------------------------------------------\n\n                                        lcd2.begin(16, 2);\n\n                                            lcd2.setCursor(0, 0);\n                                                lcd2.print(\"REG: 24BCE8046\");\n\n                                                    lcd2.setCursor(0, 1);\n                                                        lcd2.print(\"U Hari Charan\");\n\n\n                                                            // -------------------------------------------------\n                                                                // Pin configuration\n                                                                    // -------------------------------------------------\n\n                                                                        pinMode(Fan_Pin, OUTPUT);\n                                                                            pinMode(Pump_Pin, OUTPUT);\n\n                                                                                pinMode(A1, INPUT);\n                                                                                }\n\n\n                                                                                // =====================================================\n                                                                                // MAIN LOOP\n                                                                                // =====================================================\n\n                                                                                void loop()\n                                                                                {\n                                                                                    // =================================================\n                                                                                        // TEMPERATURE SENSING\n                                                                                            // =================================================\n\n                                                                                                int S1 = analogRead(A0);\n\n                                                                                                    float mV = (S1 / 1023.0) * 5000;\n\n                                                                                                        int Temp = mV / 10;\n\n\n                                                                                                            lcd.setCursor(0, 1);\n\n                                                                                                                lcd.print(\" T=\");\n                                                                                                                    lcd.print(Temp);\n                                                                                                                        lcd.print(\"'C  \");\n\n\n                                                                                                                            // =================================================\n                                                                                                                                // RAIN SENSING\n                                                                                                                                    // =================================================\n\n                                                                                                                                        int R = digitalRead(A1);\n\n\n                                                                                                                                            if (R == 0)\n                                                                                                                                                {\n                                                                                                                                                        lcd.setCursor(10, 1);\n                                                                                                                                                                lcd.print(\" R=NO \");\n                                                                                                                                                                    }\n\n\n                                                                                                                                                                        if (R == 1)\n                                                                                                                                                                            {\n                                                                                                                                                                                    lcd.setCursor(10, 1);\n                                                                                                                                                                                            lcd.print(\" R=YES \");\n                                                                                                                                                                                                }\n\n\n                                                                                                                                                                                                    // =================================================\n                                                                                                                                                                                                        // SOIL MOISTURE\n                                                                                                                                                                                                            // =================================================\n\n                                                                                                                                                                                                                int S3 = analogRead(A2);\n\n                                                                                                                                                                                                                    int SM = S3 / 10;\n\n\n                                                                                                                                                                                                                        lcd.setCursor(0, 2);\n\n                                                                                                                                                                                                                            lcd.print(\" S=\");\n                                                                                                                                                                                                                                lcd.print(SM);\n                                                                                                                                                                                                                                    lcd.print(\"%  \");\n\n\n                                                                                                                                                                                                                                        // =================================================\n                                                                                                                                                                                                                                            // AIR HUMIDITY\n                                                                                                                                                                                                                                                // =================================================\n\n                                                                                                                                                                                                                                                    int S4 = analogRead(A3);\n\n                                                                                                                                                                                                                                                        int H = S4 / 10;\n\n\n                                                                                                                                                                                                                                                            lcd.setCursor(10, 2);\n\n                                                                                                                                                                                                                                                                lcd.print(\" H=\");\n                                                                                                                                                                                                                                                                    lcd.print(H);\n                                                                                                                                                                                                                                                                        lcd.print(\"%  \");\n\n\n                                                                                                                                                                                                                                                                            // =================================================\n                                                                                                                                                                                                                                                                                // FAN CONTROL\n                                                                                                                                                                                                                                                                                    // =================================================\n\n                                                                                                                                                                                                                                                                                        if (Temp > 30)\n                                                                                                                                                                                                                                                                                            {\n                                                                                                                                                                                                                                                                                                    digitalWrite(Fan_Pin, HIGH);\n\n                                                                                                                                                                                                                                                                                                            lcd.setCursor(0, 3);\n                                                                                                                                                                                                                                                                                                                    lcd.print(\" Fan:ON  \");\n                                                                                                                                                                                                                                                                                                                        }\n                                                                                                                                                                                                                                                                                                                            else\n                                                                                                                                                                                                                                                                                                                                {\n                                                                                                                                                                                                                                                                                                                                        digitalWrite(Fan_Pin, LOW);\n\n                                                                                                                                                                                                                                                                                                                                                lcd.setCursor(0, 3);\n                                                                                                                                                                                                                                                                                                                                                        lcd.print(\" Fan:OFF \");\n                                                                                                                                                                                                                                                                                                                                                            }\n\n\n                                                                                                                                                                                                                                                                                                                                                                // =================================================\n                                                                                                                                                                                                                                                                                                                                                                    // WATER PUMP / MOTOR CONTROL\n                                                                                                                                                                                                                                                                                                                                                                        // =================================================\n\n                                                                                                                                                                                                                                                                                                                                                                            if (SM < 40 && R == 0)\n                                                                                                                                                                                                                                                                                                                                                                                {\n                                                                                                                                                                                                                                                                                                                                                                                        digitalWrite(Pump_Pin, HIGH);\n\n                                                                                                                                                                                                                                                                                                                                                                                                lcd.setCursor(10, 3);\n                                                                                                                                                                                                                                                                                                                                                                                                        lcd.print(\" Motor:ON  \");\n                                                                                                                                                                                                                                                                                                                                                                                                            }\n                                                                                                                                                                                                                                                                                                                                                                                                                else\n                                                                                                                                                                                                                                                                                                                                                                                                                    {\n                                                                                                                                                                                                                                                                                                                                                                                                                            digitalWrite(Pump_Pin, LOW);\n\n                                                                                                                                                                                                                                                                                                                                                                                                                                    lcd.setCursor(10, 3);\n                                                                                                                                                                                                                                                                                                                                                                                                                                            lcd.print(\" Motor:OFF \");\n                                                                                                                                                                                                                                                                                                                                                                                                                                                }\n                                                                                                                                                                                                                                                                                                                                                                                                                                                }","files":[],"features":{"smartWifi":false}}