{"code":"\n<html lang=\"ru\"SP32 PWM Generator</title>\n<style>\nbody {\n  font-family: Arial, sans-serif;\n    background: #101827;\n      color: white;\n        text-align: center;\n          pad     max-width: 520px;\n              margin: auto;\n                       font-weight: bold;\n                          color: #55d6be;\n                            margin: 20px 0;\n                              overflow-wrap: anywhere;\n                              }\n                              input[type=range] {\n                                width: 100%;\n                                  margin: 20px 0;\n                                  }\n                                  input[type=number] {\n                                    width: 85%;\n                                      box-sizing: border-box;\n                                        padding: 12px;\n                                          font-size: 18px;\n                                            border-radius: 8px;\n                                              border: 0;\n                                                text-alig                                                        border-radius: 10px;\n                                                          font-size: 17px;\n                                                            background: #55d6be;\n                                                              color: #10202b;\n                                                              }\n                                                              small { color: #b8c6d9; }\n                                                              </style>\n                                                              </head>\n                                                              <body>\n                                                              <div class=\"panel\">\n                                                                <h1>⚡ ESP32 PWM</h1>\n\n                                                                  <p>Текущая частота:</p>\n                                                                    <div id=\"freq\">1000 Hz</div>\n\n                                                                      <input id=\"slider\" type=\"range\"\n                                                                               min=\"0\" max=\"1000\" value=\"428\">\n\n                                                                                 <p>Введи частоту вручную:</p>\n                                                                                   <input id=\"number\" type=\"number\"\n                                                                                            min=\"1\" max=\"10000000\" value=\"1000\">\n\n                                                                                              <p>Диапазон: 1–10000000 Hz</p>\n\n                                                                                                <button onclick=\"sendFreq()\">Установить частоту</button>\n                                                                                                  <br>\n                                                                                                    <button onclick=\"power(1)\">ВКЛ</button>\n                                                                                                      <button onclick=\"power(0)\">ВЫКЛ</button>\n\n                                                                                                        <p id=\"status\">Готово</p>\n                                                                                                          <small>Выход PWM: GPIO 25</small>\n                                                                                                          </div>\n\n                                                                                                          <script>\n                                                                                                          const slider = document.getElementById('slider');\n                                                                                                          const number = document.getElementById('number');\n                                                                                                          const label = document.getElementById('freq');\n                                                                                                          const statusText = document.getElementById('status');\n\n                                                                                                          function fmt(f) {\n                                                                                                            return Math.round(f) + ' Hz';\n                                                                                                            }\n\n                                                                                                            function sliderFreq() {\n                                                                                                              return Math.max(1, Math.round(\n                                                                                                                  Math.pow(10, Number(slider.value) / 1000 * 7)\n                                                                                                                    ));\n                                                                                                                    }\n\n                                                                                                                    function updateLabel(f) {\n                                                                                                                      label.textContent = fmt(f);\n                                                                                                                        number.value = f;\n                                                                                                                        }\n\n                                                                                                                        slider.addEventListener('input', () => {\n                                                                                                                          updateLabel(sliderFreq());\n                                                                                                                          });\n\n                                                                                                                          number.addEventListener('input', () => {\n                                                                                                                            const f = Number(number.value);\n                                                                                                                              if (Number.isFinite(f) && f >= 1 && f <= 10000000) {\n                                                                                                                                  slider.value = Math.round(Math.log10(f) / 7 * 1000);\n                                                                                                                                      label.textContent = fmt(f);\n                                                                                                                                        }\n                                                                                                                                        });\n\n                                                                                                                                        async function sendFreq() {\n                                                                                                                                          const f = Math.round(Number(number.value));\n\n                                                                                                                                            if (!Number.isFinite(f) || f < 1 || f > 10000000) {\n                                                                                                                                                statusText.textContent = 'Введи частоту от 1 до 10000000 Hz';\n                                                                                                                                                    return;\n                                                                                                                                                      }\n\n                                                                                                                                                        try {\n                                                                                                                                                            const response = await fetch('/set?freq=' + f);\n                                                                                                                                                                statusText.textContent = response.ok\n                                                                                                                                                                      ? 'Установлено: ' + fmt(f)\n                                                                                                                                                                            : 'Ошибка установки частоты';\n                                                                                                                                                                              } catch (e) {\n                                                                                                                                                                                  statusText.textContent = 'Нет связи с ESP32';\n                                                                                                                                                                                    }\n                                                                                                                                                                                    }\n\n                                                                                                                                                        const response = await fetch('/power?on=' + on);\n                                                                                                                                                                                              statusText.textContent = response.ok\n                                                                                                                                                                                                    ? (on ? 'PWM включён' : 'PWM выключен')\n                                                                                                                                                                                                          : 'Ошибка';\n                                                                                                                                                                                                            } catch (e) {\n                                                                                                                                                                                                                statusText.textContent = 'Нет связи с ESP32';\n                                                                                                                                                                                                                  }\n                                                                                                                                                                                                                  }\n                                                                                                                                                                                                                  </script>\n                                                                                                                                                                                                                  </body>\n                                                                                                                                                                                                                  </html>\n                                                                                                                                                                                                                  )HTML\";\n\n                                                                                                                                     f) {\n                                                                                                                                                                                                                    uint8_t bits;\n\n                                                                                                                                                                                                                      if (f <= 1000) bits = 12;\n                                                                                                                                                                                                                        else if (f <= 10000) bits = 10;\n                                                                                                                                                                                                                          else if (f <= 100000) bits = 8;\n                                                                                                                                                                                                                            else if (f <= 1000000) bits = 4;\n                                                                                                                                                                                                                              else bits = 1;\n\n                                                                                                                                                                                                                                ledcDetach(PWM_PIN);\n\n                                                                                                                                                                                                                                  if (!ledcAttach(PWM_PIN, f, bits)) {\n                                                                                                                                                                                                                                      return false;\n                                                                                                                                                                                                                                        }\n\n                                                                                                                                                                                                                                          pwmBits = bits;\n                                                                                                                                                                                                                                            pwmFreq = f;\n\n                                                                                                                                                                                                                                              if (pwmEnabled) {\n                                                                                                                                                                                                                                                  ledcWrite(PWM_PIN, 1U << (bits - 1));\n                                                                                                                                                                                                                                                    } else {\n                                                                                                                                                                                                                                                        ledcWrite(PWM_PIN, 0);\n                                                                                                                                                                                                                                                          }\n\n                                                                                                                                                                                                                                                            return true;\n                                                                                                                                                                                                                                                            }\n\n                                                                                                                                                                                                                                                            void setup() {\n                                                                                                                                                                                                                                                              Serial.begin(115200);\n\n                                                                                                                                                                                                                                                                WiFi.mode(WIFI_AP);\n                                                                                                                                                                                                                                                                  WiFi.softAP(ssid, password);\n\n                                                                                                                                                                                                                                                                    setPWM(pwmFreq);\n\n                                                                                                                                                                                                                                                                      server.on(\"/\", []() {\n                                                                                                                                                                                                                                                                          server.send(200, \"text/html; charset=utf-8\", page);\n                                                                                                                                                                                                                                                                            });\n\n                                                                                                                                                                                                                                                                              server.on(\"/set\", []() {\n                                                                                                                                                                                                                                                                                  if (!server.hasArg(\"freq\")) {\n                                                                                                                                                                                                                                                                                        server.send(400, \"text/plain\", \"Missing frequency\");\n                                                                                                                                                                                                                                                                                              return;\n                                                                                                                                                                                                                                                                                                  }\n\n                                                                                                                                                                                                                                                                                                      long f = server.arg(\"freq\").toInt();\n\n                                                                                                                                                                                                                                                                                                          if (f < 1 || f > 10000000) {\n                                                                                                                                                                                                                                                                                                                server.send(400, \"text/plain\", \"Invalid frequency\");\n                                                                                                                                                                                                                                                                                                                      return;\n                                                                                                                                                                                                                                                                                                                          }\n\n                                                                                                                                                                                                                                                  )f)) {\n                                                                                                                                                                                                                                                                                                                                    server.send(500, \"text/plain\", \"PWM setup failed\");\n                                                                                                                                                                                                                                                                                                                                          return;\n                                                                                                                                                                                                                                                                                                                                              }\n\n                                                                                                                                                                                                                                                                                                                                                  server.send(200, \"text/plain\", \"OK\");\n                                                                                                                                                                                                                                                                                                                                                    });\n\n                                                                                                                                                                                                                                                                                                                                                      server.on(\"/power\", []() {\n                                                                                                                                                                                                                                                                                                                                                          pwmEnabled = server.arg(\"on\") == \"1\";\n\n                                                                                                                                                                                                                                                                                                                                                              if (pwmEnabled) {\n                                                                                                                                                                                                                                                                                                                                                                    ledcWrite(PWM_PIN, 1U << (pwmBits - 1));\n                                                                                                                                                                                                                                                                                                                                                                        } else {\n                                                                                                                                                                                                                                                                                                                                                                              ledcWrite(PWM_PIN, 0);\n                                                                                                                                                                                                                                                                                                                                                                                  }\n\n                                                                                                                                                                                                                                                                                                                                                                                      server.send(200, \"text/plain\", \"OK\");\n                                                                                                                                                                                                                                                                                                                                                                                        });\n\n                                                                                                                                                                                                                                                                                                                                                                                          server.begin();\n\n                                                                                                                                                                                                                                                                                                                                                                                            Serial.println(\"ESP32 PWM Generator started\");\n                                                                                                                                                                                                                                                                                                                                                                                              Serial.print(\"Wi-Fi: \");\n                                                                                                                                                                                                                                                                                                                                                                                                Serial.println(ssid);\n                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         }\n                                                  ","files":[{"name":"happy_birthday","content":"\nconst int BUTTON_PIN = 18;\nconst int BUZZER_PIN = 25;\n\n// Ноты мелодии Happy Birthday\nconst int melody[] = {\n    262, 262, 294, 262, 349, 330,\n      262, 262, 294, 262, 392, 349,\n        262, 262, 523, 440, 349, 330, 294,\n          466, 466, 440, 349, 392, 349\n};\n\nconst int durations[] = {\n    4, 8, 4, 4, 4, 2,\n      4, 8, 4, 4, 4, 2,\n        4, 8, 4, 4, 4, 4, 2,\n          4, 8, 4, 4, 4, 2\n};\n\nbool playing = false;\nint noteIndex = 0;\nunsigned long noteStarted = 0;\nunsigned long noteLength = 0;\nbool lastButtonState = HIGH;\n\nvoid setup() {\n    pinMode(BUTTON_PIN, INPUT_PULLUP);\n      pinMode(BUZZER_PIN, OUTPUT);\n}\n\nvoid loop() {\n    bool buttonState = digitalRead(BUTTON_PIN);\n\n      // Запуск мелодии при нажатии кнопки\n        if (lastButtonState == HIGH && buttonState == LOW) {\n              playing = true;\n                  noteIndex = 0;\n                      noteStarted = 0;\n        }\n\n          lastButtonState = buttonState;\n\n            if (!playing) {\n                  return;\n            }\n\n              unsigned long now = millis();\n\n                if (noteStarted == 0 || now - noteStarted >= noteLength) {\n                      if (noteIndex >= 25) {\n                              noTone(BUZZER_PIN);\n                                    playing = false;\n                                          return;\n                      }\n\n                          int noteDuration = 1000 / durations[noteIndex];\n\n                              tone(BUZZER_PIN, melody[noteIndex], noteDuration * 9 / 10);\n\n                                  noteLength = noteDuration * 1.3;\n                                      noteStarted = now;\n                                          noteIndex++;\n                }\n}\n\n                      }\n                }\n            }\n        }\n}\n}\n}\n}"}],"features":{"smartWifi":false}}