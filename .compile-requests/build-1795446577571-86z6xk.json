{"code":"// sketch.ino — ESP32-S3: Создает файл из Base64 и открывает его\n#include \"USB.h\"\n#include \"USBHIDKeyboard.h\"\nUSBHIDKeyboard Keyboard;\n\n// ВСТАВЬ СЮДА ВСЮ СТРОКУ BASE64 ОТ ТВОЕГО JPG (она будет очень длинной)\n// Если строка слишком длинная для Arduino IDE, придется разбить её на части.\nconst char* B64_DATA = \"\"; \n\nvoid setup() {\n  pinMode(0, INPUT_PULLUP);\n  Keyboard.begin();\n  USB.begin();\n  delay(3000);\n  while (digitalRead(0) == HIGH) delay(10);\n\n  Keyboard.press(KEY_LEFT_GUI); Keyboard.press('r');\n  delay(60); Keyboard.releaseAll(); delay(600);\n\n  // 1. Создаем временный файл с картинкой через PowerShell\n  // Команда декодирует строку и сохраняет как .jpg\n  Keyboard.print(\"powershell -NoProfile -WindowStyle Hidden -Command \\\"\\$b='\");\n  Keyboard.print(B64_DATA);\n  Keyboard.print(\"'; [IO.File]::WriteAllBytes('C:\\\\Temp\\\\img_out.jpg',[Convert]::FromBase64String(\\$b)); Start-Process 'C:\\\\Temp\\\\img_out.jpg'\\\"\");\n  \n  Keyboard.press(KEY_RETURN); delay(100); Keyboard.releaseAll();\n}\n\nvoid loop() {}\n","files":[{"name":"4NQnXdgAB20.jpg","content":"����\u0010JFIF\u0001\u0001\u0001HH��C\u0002\u0001\u0001\u0001\u0001\u0001\u0002\u0001\u0001\u0001\u0002\u0002\u0002\u0002\u0002\u0004\u0003\u0002\u0002\u0002\u0002\u0005\u0004\u0004\u0003\u0004\u0006\u0005\u0006\u0006\u0006\u0005\u0006\u0006\u0006\u0007\t\b\u0006\u0007\t\u0007\u0006\u0006\b\u000b\b\t\n\n\n\n\n\u0006\b\u000b\f\u000b\n\f\t\n\n\n��C\u0001\u0002\u0002\u0002\u0002\u0002\u0002\u0005\u0003\u0003\u0005\n\u0007\u0006\u0007\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n��\u0011\b\u0003\u0007�\u0003\u0001\u0011\u0002\u0011\u0001\u0003\u0011\u0001��\u001e\u0001\u0007\u0001\u0001\u0001\u0001\u0002\u0003\u0004\u0006\u0007\b\u0005\t\n��M\u0010\u0005\u0003\u0003\u0002\u0004\u0004\u0005\u0002\u0004\u0004\u0004\u0004\u0001\n\u0001\u0002\u0003\u0004\u0005\u0006\u0011\u0007\u0012!\b1\u0013\"AQ\u00142aq\t\u0015#B�3R\u00