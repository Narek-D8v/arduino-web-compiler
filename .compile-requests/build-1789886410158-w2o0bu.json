{"code":"```cpp\n#include <LiquidCrystal.h>\n\n// LCD pins: RS, E, D4, D5, D6, D7\nLiquidCrystal lcd(13, 12, 11, 10, 9, 8);\n\nconst int RedlED = 5;\nconst int GreenlED = 6;\nconst int Buzzer = 7;\n\nString id = \"\";\n\nint wait = 5000;\n\nvoid setup()\n{\n  Serial.begin(9600);\n\n    pinMode(RedlED, OUTPUT);\n      pinMode(GreenlED, OUTPUT);\n        pinMode(Buzzer, OUTPUT);\n\n          digitalWrite(RedlED, LOW);\n            digitalWrite(GreenlED, LOW);\n              digitalWrite(Buzzer, LOW);\n\n                lcd.begin(20, 4);\n\n                  lcd.setCursor(0, 0);\n                    lcd.print(\"  THE BRIGHT LIGHT \");\n\n                      lcd.setCursor(0, 1);\n                        lcd.print(\" RFID BASED LOCK SYS\");\n\n                          lcd.setCursor(0, 2);\n                            lcd.print(\" CARD: WAITING     \");\n\n                              lcd.setCursor(0, 3);\n                                lcd.print(\" NAME:             \");\n\n                                  Serial.println();\n                                    Serial.println(\"================================\");\n                                      Serial.println(\"      RFID SECURITY LOCK\");\n                                        Serial.println(\"================================\");\n                                          Serial.println(\"Please enter RFID Card Number:\");\n                                          }\n\n                                          // ======================================================\n                                          // MAIN LOOP\n                                          // ======================================================\n\n                                          void loop()\n                                          {\n                                            while (Serial.available() > 0)\n                                              {\n                                                  char c = Serial.read();\n\n                                                      // ENTER key pressed\n                                                          if (c == '\\n' || c == '\\r')\n                                                              {\n                                                                    if (id.length() > 0)\n                                                                          {\n                                                                                  checkCard();\n                                                                                        }\n                                                                                            }\n                                                                                                else\n                                                                                                    {\n                                                                                                          // Ignore spaces\n                                                                                                                if (c != ' ')\n                                                                                                                      {\n                                                                                                                              id += c;\n                                                                                                                                    }\n                                                                                                                                        }\n                                                                                                                                          }\n                                                                                                                                          }\n\n                                                                                                                                          // ======================================================\n                                                                                                                                          // CHECK CARD\n                                                                                                                                          // ======================================================\n\n                                                                                                                                          void checkCard()\n                                                                                                                                          {\n                                                                                                                                            id.toUpperCase();\n\n                                                                                                                                              Serial.println();\n                                                                                                                                                Serial.print(\"Card Number: \");\n                                                                                                                                                  Serial.println(id);\n\n                                                                                                                                                    // ----------------------------------------------------\n                                                                                                                                                      // VALID CARD 1\n                                                                                                                                                        // ----------------------------------------------------\n                                                                                                                                                          if (id == \"E280689401A9\")\n                                                                                                                                                            {\n                                                                                                                                                                validCard(\"ALTAF\");\n                                                                                                                                                                  }\n\n                                                                                                                                                                    // ----------------------------------------------------\n                                                                                                                                                                      // VALID CARD 2\n                                                                                                                                                                        // ----------------------------------------------------\n                                                                                                                                                                          else if (id == \"E2000019060C\")\n                                                                                                                                                                            {\n                                                                                                                                                                                validCard(\"ZUBAIR\");\n                                                                                                                                                                                  }\n\n                                                                                                                                                                                    // ----------------------------------------------------\n                                                                                                                                                                                      // VALID CARD 3\n                                                                                                                                                                                        // ----------------------------------------------------\n                                                                                                                                                                                          else if (id == \"G46RD9V40F3A\")\n                                                                                                                                                                                            {\n                                                                                                                                                                                                validCard(\"AMIR\");\n                                                                                                                                                                                                  }\n\n                                                                                                                                                                                                    // ----------------------------------------------------\n                                                                                                                                                                                                      // VALID CARD 4\n                                                                                                                                                                                                        // ----------------------------------------------------\n                                                                                                                                                                                                          else if (id == \"B71001B76894\")\n                                                                                                                                                                                                            {\n                                                                                                                                                                                                                validCard(\"KHALID\");\n                                                                                                                                                                                                                  }\n\n                                                                                                                                                                                                                    // ----------------------------------------------------\n                                                                                                                                                                                                                      // VALID CARD 5\n                                                                                                                                                                                                                        // ----------------------------------------------------\n                                                                                                                                                                                                                          else if (id == \"1C81159073FD\")\n                                                                                                                                                                                                                            {\n                                                                                                                                                                                                                                validCard(\"IMRAN\");\n                                                                                                                                                                                                                                  }\n\n                                                                                                                                                                                                                                    // ----------------------------------------------------\n                                                                                                                                                                                                                                      // VALID CARD 6\n                                                                                                                                                                                                                                        // ----------------------------------------------------\n                                                                                                                                                                                                                                          else if (id == \"B710D0186022\")\n                                                                                                                                                                                                                                            {\n                                                                                                                                                                                                                                                validCard(\"MEHRAN\");\n                                                                                                                                                                                                                                                  }\n\n                                                                                                                                                                                                                                                    // ----------------------------------------------------\n                                                                                                                                                                                                                                                      // INVALID CARDS\n                                                                                                                                                                                                                                                        // ----------------------------------------------------\n                                                                                                                                                                                                                                                          else if (id == \"3FD659840001\" ||\n                                                                                                                                                                                                                                                                     id == \"8115907B710E\" ||\n                                                                                                                                                                                                                                                                                id == \"66D9V45E6E77\")\n                                                                                                                                                                                                                                                                                  {\n                                                                                                                                                                                                                                                                                      invalidCard();\n                                                                                                                                                                                                                                                                                        }\n\n                                                                                                                                                                                                                                                                                          // ----------------------------------------------------\n                                                                                                                                                                                                                                                                                            // ANY OTHER CARD = INVALID\n                                                                                                                                                                                                                                                                                              // ----------------------------------------------------\n                                                                                                                                                                                                                                                                                                else\n                                                                                                                                                                                                                                                                                                  {\n                                                                                                                                                                                                                                                                                                      invalidCard();\n                                                                                                                                                                                                                                                                                                        }\n\n                                                                                                                                                                                                                                                                                                          // Clear card number for next entry\n                                                                                                                                                                                                                                                                                                            id = \"\";\n                                                                                                                                                                                                                                                                                                            }\n\n                                                                                                                                                                                                                                                                                                            // ======================================================\n                                                                                                                                                                                                                                                                                                            // VALID CARD FUNCTION\n                                                                                                                                                                                                                                                                                                            // ======================================================\n\n                                                                                                                                                                                                                                                                                                            void validCard(String name)\n                                                                                                                                                                                                                                                                                                            {\n                                                                                                                                                                                                                                                                                                              Serial.println(\"--------------------------------\");\n                                                                                                                                                                                                                                                                                                                Serial.println(\"STATUS : VALID CARD\");\n                                                                                                                                                                                                                                                                                                                  Serial.print(\"NAME   : \");\n                                                                                                                                                                                                                                                                                                                    Serial.println(name);\n                                                                                                                                                                                                                                                                                                                      Serial.println(\"ACCESS : GRANTED\");\n                                                                                                                                                                                                                                                                                                                        Serial.println(\"--------------------------------\");\n\n                                                                                                                                                                                                                                                                                                                          lcd.clear();\n\n                                                                                                                                                                                                                                                                                                                            lcd.setCursor(0, 0);\n                                                                                                                                                                                                                                                                                                                              lcd.print(\" RFID SECURITY LOCK\");\n\n                                                                                                                                                                                                                                                                                                                                lcd.setCursor(0, 1);\n                                                                                                                                                                                                                                                                                                                                  lcd.print(\" CARD: VALID\");\n\n                                                                                                                                                                                                                                                                                                                                    lcd.setCursor(0, 2);\n                                                                                                                                                                                                                                                                                                                                      lcd.print(\" NAME: \");\n                                                                                                                                                                                                                                                                                                                                        lcd.print(name);\n\n                                                                                                                                                                                                                                                                                                                                          lcd.setCursor(0, 3);\n                                                                                                                                                                                                                                                                                                                                            lcd.print(\" ACCESS GRANTED\");\n\n                                                                                                                                                                                                                                                                                                                                              digitalWrite(GreenlED, HIGH);\n\n                                                                                                                                                                                                                                                                                                                                                delay(wait);\n\n                                                                                                                                                                                                                                                                                                                                                  digitalWrite(GreenlED, LOW);\n\n                                                                                                                                                                                                                                                                                                                                                    lcd.clear();\n\n                                                                                                                                                                                                                                                                                                                                                      lcd.setCursor(0, 0);\n                                                                                                                                                                                                                                                                                                                                                        lcd.print(\"  THE BRIGHT LIGHT \");\n\n                                                                                                                                                                                                                                                                                                                                                          lcd.setCursor(0, 1);\n                                                                                                                                                                                                                                                                                                                                                            lcd.print(\" RFID BASED LOCK SYS\");\n\n                                                                                                                                                                                                                                                                                                                                                              lcd.setCursor(0, 2);\n                                                                                                                                                                                                                                                                                                                                                                lcd.print(\" CARD: WAITING     \");\n\n                                                                                                                                                                                                                                                                                                                                                                  lcd.setCursor(0, 3);\n                                                                                                                                                                                                                                                                                                                                                                    lcd.print(\" NAME:             \");\n\n                                                                                                                                                                                                                                                                                                                                                                      Serial.println();\n                                                                                                                                                                                                                                                                                                                                                                        Serial.println(\"Please enter RFID Card Number:\");\n                                                                                                                                                                                                                                                                                                                                                                        }\n\n                                                                                                                                                                                                                                                                                                                                                                        // ======================================================\n                                                                                                                                                                                                                                                                                                                                                                        // INVALID CARD FUNCTION\n                                                                                                                                                                                                                                                                                                                                                                        // ======================================================\n\n                                                                                                                                                                                                                                                                                                                                                                        void invalidCard()\n                                                                                                                                                                                                                                                                                                                                                                        {\n                                                                                                                                                                                                                                                                                                                                                                          Serial.println(\"--------------------------------\");\n                                                                                                                                                                                                                                                                                                                                                                            Serial.println(\"STATUS : INVALID CARD\");\n                                                                                                                                                                                                                                                                                                                                                                              Serial.println(\"NAME   : UNKNOWN\");\n                                                                                                                                                                                                                                                                                                                                                                                Serial.println(\"ACCESS : DENIED\");\n                                                                                                                                                                                                                                                                                                                                                                                  Serial.println(\"--------------------------------\");\n\n                                                                                                                                                                                                                                                                                                                                                                                    lcd.clear();\n\n                                                                                                                                                                                                                                                                                                                                                                                      lcd.setCursor(0, 0);\n                                                                                                                                                                                                                                                                                                                                                                                        lcd.print(\" RFID SECURITY LOCK\");\n\n                                                                                                                                                                                                                                                                                                                                                                                          lcd.setCursor(0, 1);\n                                                                                                                                                                                                                                                                                                                                                                                            lcd.print(\" CARD: INVALID\");\n\n                                                                                                                                                                                                                                                                                                                                                                                              lcd.setCursor(0, 2);\n                                                                                                                                                                                                                                                                                                                                                                                                lcd.print(\" NAME: UNKNOWN\");\n\n                                                                                                                                                                                                                                                                                                                                                                                                  lcd.setCursor(0, 3);\n                                                                                                                                                                                                                                                                                                                                                                                                    lcd.print(\" ACCESS DENIED\");\n\n                                                                                                                                                                                                                                                                                                                                                                                                      digitalWrite(RedlED, HIGH);\n\n                                                                                                                                                                                                                                                                                                                                                                                                        digitalWrite(Buzzer, HIGH);\n                                                                                                                                                                                                                                                                                                                                                                                                          delay(500);\n                                                                                                                                                                                                                                                                                                                                                                                                            digitalWrite(Buzzer, LOW);\n\n                                                                                                                                                                                                                                                                                                                                                                                                              delay(4000);\n\n                                                                                                                                                                                                                                                                                                                                                                                                                digitalWrite(RedlED, LOW);\n\n                                                                                                                                                                                                                                                                                                                                                                                                                  lcd.clear();\n\n                                                                                                                                                                                                                                                                                                                                                                                                                    lcd.setCursor(0, 0);\n                                                                                                                                                                                                                                                                                                                                                                                                                      lcd.print(\"  THE BRIGHT LIGHT \");\n\n                                                                                                                                                                                                                                                                                                                                                                                                                        lcd.setCursor(0, 1);\n                                                                                                                                                                                                                                                                                                                                                                                                                          lcd.print(\" RFID BASED LOCK SYS\");\n\n                                                                                                                                                                                                                                                                                                                                                                                                                            lcd.setCursor(0, 2);\n                                                                                                                                                                                                                                                                                                                                                                                                                              lcd.print(\" CARD: WAITING     \");\n\n                                                                                                                                                                                                                                                                                                                                                                                                                                lcd.setCursor(0, 3);\n                                                                                                                                                                                                                                                                                                                                                                                                                                  lcd.print(\" NAME:             \");\n\n                                                                                                                                                                                                                                                                                                                                                                                          